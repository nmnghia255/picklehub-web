        {
          "name": "Get my bookings",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();\r",
                  "const list = res?.data;\r",
                  "\r",
                  "if (pm.response.code === 200 && Array.isArray(list) && list.length) {\r",
                  "  const target = list.find(b => b.status === \"PENDING\") ?? list[0];\r",
                  "  pm.collectionVariables.set(\"BOOKING_ID\", target.id);\r",
                  "  console.log(\"BOOKING_ID set to:\", target.id, \"(status:\", target.status + \")\");\r",
                  "} else {\r",
                  "  console.warn(\"No bookings found; BOOKING_ID not updated.\");\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
