        {
          "name": "List courts of a center",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();\r",
                  "\r",
                  "if (pm.response.code === 200 && Array.isArray(res) && res.length) {\r",
                  "  const activeCourt = res.find(c => c.status === \"ACTIVE\");\r",
                  "\r",
                  "  if (activeCourt) {\r",
                  "    pm.collectionVariables.set(\"COURT_ID\", activeCourt.id);\r",
                  "    console.log(\"COURT_ID set to:\", activeCourt.id, \"—\", activeCourt.name);\r",
                  "  } else {\r",
                  "    console.warn(\"No ACTIVE court found; COURT_ID not updated.\");\r",
                  "  }\r",
                  "}\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
